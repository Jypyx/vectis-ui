{
  "name": "socle-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:stories": "pnpm --filter @socle/ui test:stories",
    "build": "pnpm -r build",
    "tokens": "pnpm --filter @socle/ui tokens",
    "storybook": "pnpm --filter @socle/ui storybook",
    "build-storybook": "pnpm --filter @socle/ui build-storybook",
    "chromatic": "pnpm --filter @socle/ui chromatic"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
