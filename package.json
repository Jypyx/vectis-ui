{
  "name": "vectis-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:stories": "pnpm --filter @vectis/ui test:stories",
    "test:coverage": "pnpm --filter @vectis/ui test:coverage",
    "build": "pnpm -r build",
    "tokens": "pnpm --filter @vectis/ui tokens",
    "icons": "pnpm --filter @vectis/ui icons",
    "storybook": "pnpm --filter @vectis/ui storybook",
    "build-storybook": "pnpm --filter @vectis/ui build-storybook",
    "chromatic": "pnpm --filter @vectis/ui chromatic"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.26",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
