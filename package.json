{
  "name": "vectis-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "lint": "vp lint . --max-warnings 0 && eslint --max-warnings 0 \"**/*.vue\"",
    "format": "vp fmt --check .",
    "format:fix": "vp fmt .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:stories": "pnpm --filter vectis-ui test:stories",
    "test:coverage": "pnpm --filter vectis-ui test:coverage",
    "bench": "pnpm --filter vectis-ui bench",
    "bench:size": "pnpm --filter vectis-ui bench:size",
    "build": "pnpm -r build",
    "tokens": "pnpm --filter vectis-ui tokens",
    "icons": "pnpm --filter vectis-ui icons",
    "storybook": "pnpm --filter vectis-ui storybook",
    "build-storybook": "pnpm --filter vectis-ui build-storybook",
    "chromatic": "pnpm --filter vectis-ui chromatic"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.2",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite-plus": "catalog:"
  }
}
