{
  "name": "vectis-ui",
  "version": "0.1.1-rc.0",
  "description": "Vue 3 design system — HTML/CSS first, CSS tokens, Nuxt 3 (SSR) compatible",
  "type": "module",
  "license": "MIT",
  "author": "Jypyx",
  "homepage": "https://github.com/Jypyx/vectis-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jypyx/vectis-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Jypyx/vectis-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "component-library",
    "design-tokens",
    "css-tokens",
    "accessibility",
    "ssr",
    "nuxt",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "//types": "Fallback for consumers still on moduleResolution node10, which ignores `exports` and would otherwise get NO types at all, silently.",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "icons": "tsx scripts/build-icons.ts",
    "prebuild": "pnpm run tokens",
    "build": "vite build",
    "postbuild": "tsx scripts/check-css-split.ts && tsx scripts/bench-size.ts",
    "//bench": "Runtime timings, deliberately OUTSIDE the checkpoint and never gating: a benchmark on a shared runner measures the runner. The SIZE gate is the deterministic half and runs in postbuild.",
    "bench": "vitest bench --run",
    "bench:size": "tsx scripts/bench-size.ts",
    "bench:size:update": "tsx scripts/bench-size.ts --update",
    "//check:package": "Run AFTER build, never from postbuild: attw's `--pack` shells out to `npm pack`, which fires `prepack` → `build` → postbuild → attw, i.e. unbounded recursion. CI calls it as its own step. publint reads the manifest; attw resolves every entrypoint under each moduleResolution — `styles.css` is excluded because a CSS export legitimately carries no type declarations.",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css",
    "prepack": "pnpm run build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:stories": "vitest run --project storybook",
    "test:coverage": "vitest run --coverage",
    "prestorybook": "pnpm run tokens",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "pnpm run tokens",
    "build-storybook": "storybook build",
    "chromatic": "chromatic"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/vue3-vite": "^10.5.5",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "chromatic": "^18.1.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "publint": "^0.3.23",
    "storybook": "^10.5.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  }
}
