# Nuxt's generated types, build output and caches (apps/docs). `.nuxt/` holds the
# tsconfig every `.ts` in the app is resolved against, so it is regenerated by the
# app's `postinstall` rather than committed.
.nuxt/
.output/
.data/
.nitro/

# Secrets. `.env*` covers .env, .env.local, .env.production… The negation keeps the
# template tracked: it documents which variables are expected and holds no value.
.env*
!.env.example
