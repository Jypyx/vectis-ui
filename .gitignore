node_modules/
dist/
# A pattern holding a slash is anchored to this file's directory, so the glob is what
# makes it reach apps/docs/.vitepress/cache/ (unlike `dist/` above, which is unanchored).
**/.vitepress/cache/
storybook-static/
coverage/
*.log
.DS_Store
*.tsbuildinfo

# Secrets. `.env*` covers .env, .env.local, .env.production… The negation keeps the
# template tracked: it documents which variables are expected and holds no value.
.env*
!.env.example
